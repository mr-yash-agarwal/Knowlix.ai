# Knowlix AI Backend Environment Configuration
# Open-Source AI Personalized Learning Platform Powered by Gemma 4

ENVIRONMENT=development
DATABASE_PATH=./data/knowlix.db

# Central AI Intelligence — Gemma 4 accessed through Gemini API
# Model Identifiers:
# - "gemma-4-31b-it" (Primary: Dense 31B instruction-tuned model, multimodal text + images, 256k context)
# - "gemma-4-26b-a4b-it" (Alternative: Mixture-of-Experts 26B model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
GEMMA_MODEL_LICENSE=Gemma Open License

# Authentication & Security
# Generate secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_HOURS=72

# Multi-Modal Upload & Document Processing Limits
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=25

# Legacy / Alternative Open-Weight Options (Ollama, vLLM)
VISION_MODEL_PROVIDER=gemma
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_VLLM_HOST=http://127.0.0.1:8000/v1

GEMMA_FALLBACK_MODELS=gemma-4-31b-it
