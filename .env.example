# Knowlix AI Root Environment Configuration
# Open-Source AI Personalized Learning Platform Powered by Gemma 4

# Backend Settings
ENVIRONMENT=development
DATABASE_PATH=./data/knowlix.db

# Central AI Intelligence — Gemma 4 accessed through Gemini API
# Primary model: gemma-4-31b-it | Alternative: gemma-4-26b-a4b-it
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_NAME=gemma-4-31b-it
GEMMA_MODEL_LICENSE=Gemma Open License

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_HOURS=72

# Upload Limits
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=25

# Frontend
VITE_API_URL=http://127.0.0.1:8000
